SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/lczz_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=lczz_app
DB_PASSWORD=replace-locally
JWT_ISSUER=lczz
JWT_SECRET=replace-with-at-least-32-random-bytes
FILE_STORAGE_TYPE=LOCAL
FILE_LOCAL_ROOT=./data/uploads
FILE_MAX_SIZE=200MB
FILE_MAX_REQUEST_SIZE=205MB
FILE_MAX_BYTES=209715200
FILE_MAX_IMAGE_BYTES=10485760
FILE_SIGNED_URL_MINUTES=60

# 仅本机 local Profile 联调使用；生产环境必须保持 false。
DEV_AUTH_ENABLED=false
DEV_AUTH_PASSWORD=replace-with-at-least-12-characters

# 阿里云短信：生产环境使用 RAM 子账号最小权限；绝不将真实 AccessKey 提交到仓库。
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_DEALER_APPOINTMENT_TEMPLATE_CODE=
SMS_INSTALLER_ASSIGNMENT_TEMPLATE_CODE=
# 多个管理人员手机号以英文逗号分隔；可使用 +86 前缀。
SMS_ADMIN_PHONES=
# 仅供师傅自助取货订单展示，后续 #102 使用。
SMS_PICKUP_CONTACT_PHONE=
SMS_MAX_ATTEMPTS=3
SMS_RETRY_DELAY_MS=60000
