# Include these directives in the production server block or the location
# that proxies https://admin.whlczz.cn/api/ to the Spring Boot service.
client_max_body_size 205m;
client_body_timeout 600s;
proxy_connect_timeout 60s;
proxy_send_timeout 600s;
proxy_read_timeout 600s;

# Stream large request bodies to the backend instead of buffering the entire
# video in the Nginx temporary-file area.
proxy_request_buffering off;
