				"iconPath": "static/tabbar/function.png",
				"selectedIconPath": "static/tabbar/functionActive.png"
			},
			{
				"pagePath": "pages/user/user",
				"text": "我的",
				"iconPath": "static/tabbar/user.png",
				"selectedIconPath": "static/tabbar/userActive.png"
