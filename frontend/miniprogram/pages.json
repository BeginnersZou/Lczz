	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "鑫立创",
		"navigationBarBackgroundColor": "#ffffff",
		"backgroundColor": "#f4f7fb",
		"backgroundColorTop": "#f4f7fb",
		"backgroundColorBottom": "#f4f7fb"
	},
	"tabBar": {
		"color": "#808080",
		"selectedColor": "#0b63ce",
		"borderStyle": "white",
		"backgroundColor": "#ffffff",
		"height": "55px",
		"spacing": "3px",
		"iconWidth": "24px",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页",
				"iconPath": "static/tabbar/home.png",
				"selectedIconPath": "static/tabbar/homeActive.png"
			},
			{
				"pagePath": "pages/official/official",
				"text": "服务",
