{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"enablePullDownRefresh": true,
				"navigationBarTitleText": "鑫立创",
				"navigationBarBackgroundColor": "#0b63ce",
				"navigationBarTextStyle": "white",
				"backgroundColorTop": "#0b63ce",
				"backgroundColorBottom": "#f4f7fb"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationStyle": "custom",
				"enablePullDownRefresh": false,
				"app-plus": {
					"titleView": false
				}
			}
		},
		{
			"path": "pages/official/official",
			"style": {
				"navigationBarTitleText": "品牌服务",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom",
				"navigationBarTextStyle": "black",
				"backgroundColorTop": "#0b63ce",
				"backgroundColorBottom": "#f4f7fb"
			}
		},
		{
			"path": "pages/order/order",
			"style": {
				"navigationBarTitleText": "我的订单",
				"enablePullDownRefresh": true,
				"navigationBarTextStyle": "black",
				"backgroundColorTop": "#f4f7fb",
				"backgroundColorBottom": "#f4f7fb"
			}
		},
		{
			"path": "pages/user/user",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationStyle": "custom",
				"navigationBarTextStyle": "black",
				"backgroundColorTop": "#0b63ce",
				"backgroundColorBottom": "#f4f7fb"
			}
		}
	],
	"subPackages": [
		{
			"root": "packageA",
			"pages": [
				{
					"path": "order-detail/order-detail",
					"style": {
						"navigationBarTitleText": "订单详情",
						"navigationBarTextStyle": "black",
						"backgroundColorTop": "#f4f7fb",
						"backgroundColorBottom": "#f4f7fb"
					}
				},
				{
